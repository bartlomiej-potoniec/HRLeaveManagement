@page "/users/list"
@attribute [Authorize(Roles = "Administrator")]

@using HRLeaveManagement.BlazorUI.ViewModels.Users

<PageTitle>User list</PageTitle>

<HrHeader>
    <HeaderChildContent>
        User list
    </HeaderChildContent>

    <BodyChildContent>
        <MudButton Href="auth/register-user/" 
                   Variant="Variant.Outlined"
                   Size="Size.Small" 
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.AddCircle" 
                   Class="mr-2">
            New user
        </MudButton>
    </BodyChildContent>
</HrHeader>

<MudGrid Class="d-flex justify-space-between align-end">
    <MudItem>
        <HrUsersListActionsGroup T="UserDetailsViewModel" DataGrid="@_dataGrid" IsChoosen="@_isChoosenMany" />
    </MudItem>
    <MudItem Class="d-flex align-center">
        <MudSwitch @bind-Value="_isChoosenMany" Color="Color.Primary">Select rows</MudSwitch>
    </MudItem>
</MudGrid>

<MudDataGrid T="UserDetailsViewModel" 
             @ref="_dataGrid" 
             ServerData="LoadServerData" 
             Loading="@_isLoading" 
             MultiSelection 
             SelectOnRowClick="@_isChoosenMany"
             LoadingProgressColor="Color.Primary" 
             Filterable 
             FilterMode="DataGridFilterMode.ColumnFilterRow" 
             Striped 
             Dense 
             Class="mt-5">
    <ToolBarContent>
        <MudIcon Icon="@Icons.Material.Filled.ViewList" />
        <MudText Typo="Typo.h6" Style="font-size: 18px; letter-spacing: .7px; margin-left: 10px;">User list</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Szukaj" 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search" 
                      IconSize="Size.Medium" 
                      Clearable 
                      Class="mt-0">
        </MudTextField>
    </ToolBarContent>
    <Columns>
        <SelectColumn T="UserDetailsViewModel" Hidden="!(_isChoosenMany)" />
        <PropertyColumn Property="u => u.ShortId" Title="Identifier" HeaderStyle="font-weight:700;" Filterable="false" Sortable="false" />
        <PropertyColumn Property="u => u.FullName" Title="First and lastname" HeaderStyle="font-weight:700;" />
        <PropertyColumn Property="u => u.UserName" Title="Username" HeaderStyle="font-weight:700;" />
        <PropertyColumn Property="u => u.Email" Title="E-mail" HeaderStyle="font-weight:700;" />
        <PropertyColumn Property="u => u.PhoneNumber" Title="Phone no." HeaderStyle="font-weight:700;" Sortable="false" />
        <PropertyColumn Property="u => u.Roles" Title="Roles" @ref="@_rolesColumn" Sortable="false" HeaderStyle="font-weight: 700;">
            <CellTemplate>
                <HrUserRoleCell Roles="@context.Item.Roles" />
            </CellTemplate>
            <FilterTemplate>
                <HrUserRoleFilter T="UserDetailsViewModel"
                                  Data="@AllData"
                                  Column="@_rolesColumn"
                                  Context="@context"
                                  FilterDefinitions="@context.FilterDefinitions" />
            </FilterTemplate>
        </PropertyColumn>
        <PropertyColumn Property="u => u.AccountStatus" Title="Status" @ref="@_accountStatusColumn" HeaderStyle="font-weight:700;">
            <FilterTemplate>
                <HrUserAccountStatusFilter T="UserDetailsViewModel" 
                                           Data="@AllData"
                                           Column="@_accountStatusColumn"
                                           Context="@context" 
                                           FilterDefinitions="@context.FilterDefinitions" />
            </FilterTemplate>
        </PropertyColumn>
        <TemplateColumn HeaderStyle="font-weight:700;" Title="Actions" Sortable="false" Filterable="false">
            <CellTemplate>
                <HrUserActionsCell UserId="@context.Item.Id.ToString()" 
                                   UserName="@context.Item.UserName" 
                                   IsUserLockout="@context.Item.IsLockout" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="UserDetailsViewModel" PageSizeOptions="[10, 15, 20, 25, 30]" />
    </PagerContent>
</MudDataGrid>
