@page "/users/{id}/details"
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>Details of user @Model.UserName</PageTitle>

<MudOverlay Visible="@_isLoading" LightBackground>
    <HrProgressCircular />
</MudOverlay>

@if (!_isLoading)
{
    <HrHeader>
        <HeaderChildContent>
            Details of user @Model.UserName
        </HeaderChildContent>
    </HrHeader>

    <MudGrid Class="mt-2">
        <MudItem xs="12" lg="8">
            <HrSection Title="User information" Icon="@Icons.Material.Filled.Info" MinHeight="590px">
                <HeaderChildContent>
                    <MudButton Href="@($"users/{ Model.Id }/edit")"
                               Style="margin-top: 8px;"
                               ButtonType="ButtonType.Button"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit">
                        Edit
                    </MudButton>
                </HeaderChildContent>
                <BodyChildContent>
                    <HrFormDivider Text="Basic information" />

                    <HrFormTextInput T="string"
                                     Label="Firstname"
                                     InputId="FirstName"
                                     Value="@Model.FirstName"
                                     Variant="Variant.Text"
                                     Margin="Margin.Normal"
                                     IsReadOnly />

                    <HrFormTextInput T="string"
                                     Label="Lastname"
                                     InputId="LastName"
                                     Value="@Model.LastName"
                                     Variant="Variant.Text"
                                     Margin="Margin.Normal"
                                     IsReadOnly />

                    <HrFormTextInput T="string"
                                     Label="E-mail"
                                     InputId="Email"
                                     Value="@Model.Email"
                                     Variant="Variant.Text"
                                     Margin="Margin.Normal"
                                     IsReadOnly />

                    <HrFormDateInput Label="Date of birth"
                                     InputId="DateOfBirth"
                                     Date="@Model.DateOfBirth"
                                     Variant="Variant.Text"
                                     Margin="Margin.Normal"
                                     IsReadOnly />

                    <HrFormTextInput T="string"
                                     Label="PESEL number"
                                     InputId="Pesel"
                                     Value="@Model.PeselNumber"
                                     Variant="Variant.Text"
                                     Margin="Margin.Normal"
                                     IsReadOnly />

                    <HrFormTextInput T="string"
                                     Label="Phone number"
                                     InputId="PhoneNumber"
                                     Value="@Model.PhoneNumber"
                                     Variant="Variant.Text"
                                     Margin="Margin.Normal"
                                     IsReadOnly />

                    <HrFormDivider Text="User roles" />

                    <HrRoleDisplay Roles="Model.Roles" ChipColor="Color.Primary" MarginTop="20px" IsReadOnly />
                </BodyChildContent>
            </HrSection>
        </MudItem>

        <MudItem xs="12" lg="4">
            <HrUserAccountInfoSection UserId="@Model.Id.ToString()" Height="100%" />
        </MudItem>

        <MudItem xs="12" lg="8">
            <HrLogSection Height="350px" />
        </MudItem>

        <MudItem xs="12" lg="4">
            <HrAnotherUsersSection ActualUserId="@Model.Id.ToString()" Height="350px" />
        </MudItem>
    </MudGrid>
}