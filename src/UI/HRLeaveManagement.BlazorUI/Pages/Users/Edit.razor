@page "/users/{id}/edit"
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>Editing user @Model.UserName</PageTitle>

<MudOverlay Visible="@_isLoading" LightBackground>
    <HrProgressCircular />
</MudOverlay>

@if (!_isLoading)
{
    <HrHeader>
        <HeaderChildContent>
            Editing user @Model.UserName
        </HeaderChildContent>
    </HrHeader>

    <MudGrid Class="mt-2">
        <MudItem xs="12" lg="8">
            <MudForm Model="@Model" @ref="@Form" Validation="@(Validator.ValidateValue)">
                <HrSection Title="User edition" Icon="@Icons.Material.Filled.Edit" MinHeight="590px">
                    <HeaderChildContent>
                        <MudButton Href="@($"/users/{ Model.Id }/details")"
                                   ButtonType="ButtonType.Reset"
                                   Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Style="margin-top: 8px;">
                            Cancel
                        </MudButton>
                        <MudButton ButtonType="ButtonType.Button"
                                   Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Rounded.Create"
                                   Color="Color.Primary"
                                   OnClick="@(() => SaveChangesAsync())"
                                   Style="margin-top: 8px;">
                            Submit
                        </MudButton>
                    </HeaderChildContent>
                    <BodyChildContent>
                        <HrFormDivider Text="Basic information" />

                        <HrFormTextInput T="string" Label="Firstname" InputId="FirstName" @bind-Value="@Model.FirstName" For="@(() => Model.FirstName)" />
                        <HrFormTextInput T="string" Label="Lastname" InputId="LastName" @bind-Value="@Model.LastName" For="@(() => Model.LastName)" />
                        <HrFormTextInput T="string" Label="E-mail" InputId="Email" @bind-Value="@Model.Email" For="@(() => Model.Email)" />
                        <HrFormDateInput Label="Date of birth" InputId="DateOfBirth" @bind-Date="@Model.DateOfBirth" For="@(() => Model.DateOfBirth)" />
                        <MudItem xs="9" Style="padding-top: 0px; display: flex; align-items: center;">
                            <MudInputLabel ForId="Pesel" Style="min-width: 230px;">PESEL number</MudInputLabel>
                            <MudTextField Typo="Typo.body2"
                                          InputId="Pesel"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Style="font-size: 14px;"
                                          @bind-Value="Model.PeselNumber"
                                          For="@(() => Model.PeselNumber)"
                                          Disabled="@(!Model.HasPeselNumber)"
                                          Immediate
                                          Clearable />
                        </MudItem>
                        <MudItem xs="3" Style="padding-top: 0px; display: flex; align-items: center;">
                            <MudCheckBox T="bool" Value="@Model.HasPeselNumber" ValueChanged="@(value => HasPeselNumberAsync(value))">
                                @Model.HasPeselInfoMessage
                            </MudCheckBox>
                        </MudItem>
                        <HrFormTextInput T="string" Label="Phone number" InputId="PhoneNumber" @bind-Value="@Model.PhoneNumber" For="@(() => Model.PhoneNumber)" />

                        <HrFormDivider Text="User roles" />

                        <HrRoleSelector Roles="@Model.Roles" RolesChanged="@(roles => Model.Roles = roles)" />
                    </BodyChildContent>
                </HrSection>
            </MudForm>
        </MudItem>

        <MudItem xs="12" lg="4">
            <HrUserAccountInfoSection UserId="@Model.Id.ToString()" Height="100%" />
        </MudItem>

        <MudItem xs="12" lg="8">
            <HrLogSection Height="350px" />
        </MudItem>

        <MudItem xs="12" lg="4">
            <HrAnotherUsersSection ActualUserId="@Model.Id.ToString()" Height="350px" />
        </MudItem>
    </MudGrid>
}