@page "/employees/create"
@attribute [Authorize(Roles = "HR")]

@using HRLeaveManagement.BlazorUI.ViewModels.Users

<PageTitle>Create a new employee</PageTitle>

<MudOverlay Visible="@_isLoading" LightBackground>
    <HrProgressCircular />
</MudOverlay>

<HrHeader>
    <HeaderChildContent>Create a new employee</HeaderChildContent>
</HrHeader>

<MudGrid Class="mt-2">
    <MudItem xs="12" lg="8">
        <MudForm Model="@Model" @ref="@Form" Validation="@(Validator.ValidateValue)">
            <HrSection Title="Employee creation" Icon="@Icons.Material.Filled.AddCircle" MinHeight="590px">
                <HeaderChildContent>
                    <MudButton Style="margin-top: 8px;" 
                               ButtonType="ButtonType.Reset" 
                               Variant="Variant.Filled" 
                               StartIcon="@Icons.Material.Rounded.RestartAlt">
                        Reset
                    </MudButton>
                    <MudButton Style="margin-top: 8px;" 
                               ButtonType="ButtonType.Button" 
                               Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Rounded.Create" 
                               OnClick="@(async () => await HandleValidSubmit())">
                        Submit
                    </MudButton>
                </HeaderChildContent>
                <BodyChildContent>
                    <HrFormDivider Text="User" />
                    <HrUserSelect T="UserDetailsViewModel"
                                  User="@User"
                                  UserId="@Model.UserId"
                                  IdSelector="@(user => user.Id)" 
                                  UserChanged="@(user => User = user)" 
                                  UserIdChanged="@(id => Model.UserId = id)" />

                    <HrFormDivider Text="Employee information" />
                    <HrFormTextInput T="string" 
                                     InputId="Position" 
                                     Label="Position"
                                     @bind-Value="Model.Position"
                                     For="@(() => Model.Position)"
                                     IsDisabled="@(User is null)" />

                    <HrFormTextAreaInput T="string" 
                                         Lines="2"
                                         InputId="Responsibilities" 
                                         Label="Responsibilities"
                                         @bind-Value="Model.Responsibilities" 
                                         For="@(() => Model.Responsibilities)" 
                                         IsDisabled="@(User is null)" />

                    <HrSectionSelect @bind-Value="@Model.SectionId" 
                                     For="@(() => Model.SectionId)" 
                                     OnDataLoaded="@SectionLoaded"
                                     IsDisabled="@(User is null)" />
                    
                    <HrLeaderSelect @bind-Value="@Model.LeaderId" 
                                    For="@(() => Model.LeaderId)" 
                                    OnDataLoaded="@LeaderLoaded"
                                    IsDisabled="@(User is null)" />

                    <HrFormDivider Text="Education and qualifications" />
                    <HrEmployeeEducationList Educations="@Model.Educations" 
                                             EmployeeFullName="@User?.FullName" 
                                             EducationsChanged="@(edus => Model.Educations = edus)"
                                             IsDisabled="@(User is null)"
                                             HasOptionsButtons
                                             HasOptionsForItems />

                    <HrFormDivider Text="Professional experience" />
                    <HrEmployeeExperienceList Experiences="@Model.Experiences"
                                              EmployeeFullName="@User?.FullName"
                                              ExperiencesChanged="@(exps => Model.Experiences = exps)"
                                              IsDisabled="@(User is null)"
                                              HasOptionsButtons
                                              HasOptionsForItems />
                    
                    <HrFormDivider Text="Current contract" />
                    <HrEmployeeContractTypeSelect @bind-ContractType="@Model.Contract.ContractType"
                                                  ContractTypes="@Model.Contract.ContractTypes"
                                                  For="@(() => Model.Contract.ContractType)"
                                                  IsDisabled="@(User is null)" /> 
                    <MudFlexBreak />
                    <HrFormDateInput Xs="8"
                                     InputId="StartedAt"
                                     Label="Start date"
                                     @bind-Date="@Model.Contract.StartedAt"
                                     For="@(() => Model.Contract.StartedAt)"
                                     IsDisabled="@(User is null)" />

                    <HrContractForIndefinitePeriodCheckBox Contract="@Model.Contract"
                                                           ContractChanged="@(contract => Model.Contract = contract)" 
                                                           IsDisabled="@(User is null)" />

                    @if (!Model.Contract.IsContractForIndefinitePeriod)
                    {
                        <HrFormDateInput Xs="8"
                                         InputId="ExpiredAt"
                                         Label="Expiration date"
                                         @bind-Date="@Model.Contract.ExpiredAt"
                                         For="@(() => Model.Contract.ExpiredAt)"
                                         IsDisabled="@(User is null)" />
                    }
                </BodyChildContent>
            </HrSection> 
        </MudForm>
    </MudItem>

    <MudItem xs="12" lg="4">
        <HrUserInfoSection UserId="@User?.Id.ToString()" Height="100%" />
    </MudItem>

    <MudItem xs="12" lg="8">
        <HrLogSection Height="350px" />
    </MudItem>

    <MudItem xs="12" lg="4">
        <HrAnotherEmployeesSection Height="350px" />
    </MudItem>
</MudGrid>   
