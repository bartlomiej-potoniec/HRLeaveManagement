@page "/employees/{id}/details"
@attribute [Authorize(Roles = "HR")]

<PageTitle>Details of employee @Model.FullName</PageTitle>

<MudOverlay Visible="@_isLoading" LightBackground>
    <HrProgressCircular />
</MudOverlay>

@if (!_isLoading)
{
    <HrHeader>
        <HeaderChildContent>
            Details of employee @Model.FullName
        </HeaderChildContent>
    </HrHeader>

    <MudGrid Class="mt-2">
        <MudItem xs="12" lg="8">
            <MudForm Model="@Model">
                <HrSection Title="Employee details" Icon="@Icons.Material.Filled.Info" MinHeight="590px">
                    <HeaderChildContent>
                        <MudButton Style="margin-top: 8px;" 
                                   ButtonType="ButtonType.Button" 
                                   Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Rounded.Create" 
                                   Href="@($"employees/{ Id }/edit/")">
                            Submit
                        </MudButton>
                    </HeaderChildContent>
                    <BodyChildContent>
                        <HrFormDivider Text="User" />
                        <HrFormTextInput T="string"
                                         Xs="8"
                                         InputId="User"
                                         Label="Selected user"
                                         Value="@Model.FullName"
                                         Margin="Margin.Normal"
                                         Variant="Variant.Text"
                                         IsReadOnly />

                        <HrFormDivider Text="Employee information" />
                        <HrFormTextInput T="string"
                                         InputId="Position"
                                         Label="Position"
                                         Value="@Model.Position"
                                         Margin="Margin.Normal"
                                         Variant="Variant.Text"
                                         IsReadOnly />
                    
                        <HrFormTextAreaInput T="string"
                                             Lines="2"
                                             InputId="Responsibilities"
                                             Label="Responsibilities"
                                             Value="@Model.Responsibilities"
                                             Margin="Margin.Normal"
                                             IsReadOnly />
                    
                        <HrFormTextInput T="string"
                                         InputId="FullSection"
                                         Label="Department and section"
                                         Value="Model.SectionFullInfo"
                                         Margin="Margin.Normal"
                                         Variant="Variant.Text"
                                         IsReadOnly />
                    
                        <HrFormTextInput T="string"
                                         InputId="Leader"
                                         Label="Leader"
                                         Value="Model.LeaderName"
                                         Margin="Margin.Normal"
                                         Variant="Variant.Text"
                                         IsReadOnly />

                        <HrFormDivider Text="Education and qualifications" />
                        <HrEmployeeEducationList Educations="@Model.Educations" />

                        <HrFormDivider Text="Professional experience" />
                        <HrEmployeeExperienceList Experiences="@Model.Experiences" />

                        <HrFormDivider Text="Contracts" />
                        <HrEmployeeContractList Contracts="@Model.Contracts" />
                    </BodyChildContent>
                </HrSection>
            </MudForm>
        </MudItem>

        <MudItem xs="12" lg="4">
            <HrUserInfoSection UserId="@Model?.UserId.ToString()" Height="100%" />
        </MudItem>

        <MudItem xs="12" lg="8">
            <HrLogSection Height="350px" />
        </MudItem>

        <MudItem xs="12" lg="4">
            <HrAnotherEmployeesSection ActualEmployeeId="@Model.EmployeeId.ToString()" Height="350px" />
        </MudItem>
    </MudGrid>
}