@page "/employees/{id}/edit"
@attribute [Authorize(Roles = "HR")]

<PageTitle>Editing employee @Model.FullName</PageTitle>

<MudOverlay Visible="@_isLoading" LightBackground>
    <HrProgressCircular />
</MudOverlay>

@if (!_isLoading)
{
    <HrHeader>
        <HeaderChildContent>
            Editing employee @Model.FullName
        </HeaderChildContent>
    </HrHeader>

    <MudGrid Class="mt-2">
        <MudItem xs="12" lg="8">
            <MudForm Model="@Model" @ref="@Form" Validation="@(Validator.ValidateValue)">
                <HrSection Title="Editing employee" Icon="@Icons.Material.Filled.Edit" MinHeight="590px">
                    <HeaderChildContent>
                        <MudButton Href="@($"/employees/{ Model.EmployeeId }/details")" 
                                   Style="margin-top: 8px;" 
                                   ButtonType="ButtonType.Reset" 
                                   Variant="Variant.Filled" 
                                   StartIcon="@Icons.Material.Filled.Cancel">
                            Cancel
                        </MudButton>
                        <MudButton Style="margin-top: 8px;" 
                                   ButtonType="ButtonType.Button" 
                                   Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Rounded.Create" 
                                   OnClick="@(async () => await HandleValidSubmit())">
                            Submit
                        </MudButton>
                    </HeaderChildContent>
                    <BodyChildContent>
                        <HrFormDivider Text="User" />
                        <HrFormTextInput T="string"
                                         Xs="8"
                                         InputId="User"
                                         Label="Selected user"
                                         Value="@Model.FullName"
                                         Margin="Margin.Normal"
                                         Variant="Variant.Text"
                                         IsReadOnly />

                        <HrFormDivider Text="Employee information" />
                        <HrFormTextInput T="string"
                                         InputId="Position"
                                         Label="Position"
                                         @bind-Value="Model.Position"
                                         For="@(() => Model.Position)" />

                        <HrFormTextAreaInput T="string"
                                             Lines="2"
                                             InputId="Responsibilities"
                                             Label="Responsibilities"
                                             @bind-Value="Model.Responsibilities"
                                             For="@(() => Model.Responsibilities)" />

                        <HrSectionSelect @bind-Value="@Model.SectionId" For="@(() => Model.SectionId)" />
                        <HrLeaderSelect @bind-Value="@Model.LeaderId" For="@(() => Model.LeaderId)" />

                        <HrFormDivider Text="Education and qualifications" />
                        <HrEmployeeEducationList Educations="@Model.Educations" 
                                                 EmployeeFullName="@Model.FullName"
                                                 EducationsChanged="@(edus => Model.Educations = edus)"
                                                 HasOptionsButtons 
                                                 HasOptionsForItems />

                        <HrFormDivider Text="Professional experience" />
                        <HrEmployeeExperienceList Experiences="@Model.Experiences"
                                                  EmployeeFullName="@Model.FullName"
                                                  ExperiencesChanged="@(exps => Model.Experiences = exps)"
                                                  HasOptionsButtons
                                                  HasOptionsForItems />

                        <HrFormDivider Text="Contracts" />
                        <HrEmployeeContractList Contracts="@Model.Contracts"
                                                EmployeeFullName="@Model.FullName" 
                                                ContractsChanged="cons => Model.Contracts = cons"
                                                HasOptionsButtons
                                                HasOptionsForItems />
                    </BodyChildContent>
                </HrSection>
            </MudForm>
        </MudItem>

        <MudItem xs="12" lg="4">
            <HrUserInfoSection UserId="@Model?.UserId.ToString()" Height="100%" />
        </MudItem>

        <MudItem xs="12" lg="8">
            <HrLogSection Height="350px" />
        </MudItem>

        <MudItem xs="12" lg="4">
            <HrAnotherEmployeesSection ActualEmployeeId="@Model.EmployeeId.ToString()" Height="350px" />
        </MudItem>
    </MudGrid>
}