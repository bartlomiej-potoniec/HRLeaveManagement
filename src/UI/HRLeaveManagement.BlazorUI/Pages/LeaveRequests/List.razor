@page "/leave-requests/list/"
@attribute [Authorize(Roles = "Employee")]

<HrUnderConstructionAlert />

<HrHeader>
    <HeaderChildContent>
        Leave request list
    </HeaderChildContent>
    <BodyChildContent>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AreaChart" Size="Size.Small" Class="mr-1">Chart</MudButton>
        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Class="mr-1">
            <MudButton StartIcon="@Icons.Material.Filled.ImportExport">Export to...</MudButton>
            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;">
                <MudMenuItem>Export to CSV</MudMenuItem>
                <MudMenuItem>Export to PDF</MudMenuItem>
            </MudMenu>
        </MudButtonGroup>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AddCircle" Size="Size.Small" Class="mr-2">New request</MudButton>
    </BodyChildContent>
</HrHeader>

<MudTable Items="_items" SortLabel="Sort by" Hover Class="mt-5">
    <HeaderContent>
        <MudTh Style="font-weight: bold">
            <MudTableSortLabel SortBy="new Func<object, object>(x => x)">Request no.</MudTableSortLabel>
        </MudTh>
        <MudTh Style="font-weight: bold">
            <MudTableSortLabel SortBy="new Func<object, object>(x => x)">Request type</MudTableSortLabel>
        </MudTh>
        <MudTh Style="font-weight: bold">
            <MudTableSortLabel SortBy="new Func<object, object>(x => x)">From-To date</MudTableSortLabel>
        </MudTh>
        <MudTh Style="font-weight: bold">Days count</MudTh>
        <MudTh Style="font-weight: bold">
            <MudTableSortLabel SortBy="new Func<object, object>(x => x)">Status</MudTableSortLabel>
        </MudTh>
        <MudTh Style="font-weight: bold">
            <MudTableSortLabel SortBy="new Func<object, object>(x => x)">Submission date</MudTableSortLabel>
        </MudTh>
        <MudTh Style="font-weight: bold">
            <MudTableSortLabel SortBy="new Func<object, object>(x => x)">Decision date</MudTableSortLabel>
        </MudTh>
        <MudTh Style="font-weight: bold">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Request no.">#@context.Id</MudTd>
        <MudTd DataLabel="Request type">@context.Type</MudTd>
        <MudTd DataLabel="From-To date">@context.From.ToString("dd.MM.yyyy") - @context.To.ToString("dd.MM.yyyy")</MudTd>
        <MudTd DataLabel="Days count">@context.DaysCount</MudTd>
        <MudTd DataLabel="Status">@context.Status</MudTd>
        <MudTd DataLabel="Submission date">@context.CreatedAt</MudTd>
        <MudTd DataLabel="Decision date">@context.DecidedAt</MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Info" aria-label="details" Size="Size.Small" />
            <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" aria-label="cancel" Size="Size.Small" />
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 10, 15, 20, 25, 30 }" />
    </PagerContent>
</MudTable>

@code {
    private List<LeaveRequest> _items = [
        new(1, "Vacation leave request", new DateTime(2024, 7, 23), new DateTime(2024, 7, 25), "Pending", DateTime.Now),
    ];

    class LeaveRequest
    {
        public int Id { get; set; }
        public string Type { get; set; }
        public DateTime From { get; set; }
        public DateTime To { get; set; }
        public int DaysCount => (int)To.Subtract(From).TotalDays;
        public string Status { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime? DecidedAt { get; set; }

        public LeaveRequest(int id, string type, DateTime from, DateTime to, string status, DateTime createdAt, DateTime? decidedAt = null)
        {
            Id = id;
            Type = type;
            From = from;
            To = to;
            Status = status;
            CreatedAt = createdAt;
            DecidedAt = decidedAt;
        }
    }
}