@page "/overtime-request/create"
@attribute [Authorize(Roles = "Employee")]

<HrUnderConstructionAlert />

<HrHeader>
    <HeaderChildContent>Overtime request</HeaderChildContent>
</HrHeader>

<MudGrid>
    <MudItem xs="12" lg="8">
        <MudForm>
            <MudCard>
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Style="margin-top: 5px;" Icon="@Icons.Material.Filled.AddCircle" Size="Size.Medium" />
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Style="font-size: 17px; letter-spacing: .7px;">New request</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Style="margin-top: 8px;" ButtonType="ButtonType.Reset" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.RestartAlt">Reset</MudButton>
                        <MudButton Style="margin-top: 8px;" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Submit</MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudDivider DividerType="DividerType.Middle" />
                <MudCardContent>
                    <MudGrid Style="padding: 5px 18px; padding-bottom: 30px; display: flex; align-items: center;">
                        <MudItem xs="12">
                            <MudText Typo="Typo.h6" Style="font-size: 16px; letter-spacing: .7px;">Document</MudText>
                            <MudDivider Class="mb-3" />
                        </MudItem>
                        <MudItem xs="8" Style="padding-top: 0px; display: flex; align-items: center;">
                            <MudInputLabel ForId="RequestType" Style="min-width: 230px;">Request type</MudInputLabel>
                            <MudTextField Typo="Typo.body2" InputId="RequestType" Variant="Variant.Outlined" Margin="Margin.Dense" Style="font-size: 14px;" Disabled @bind-Value="_documentType" />
                        </MudItem>


                        <MudItem xs="12">
                            <MudText Typo="Typo.h6" Style="font-size: 16px; letter-spacing: .7px;">Request</MudText>
                            <MudDivider Class="mb-3" />
                        </MudItem>

                        <MudItem xs="8" Style="padding-top: 0px; display: flex; align-items: center;">
                            <MudInputLabel ForId="Employee" Style="min-width: 230px;">Employee</MudInputLabel>
                            <MudTextField Typo="Typo.body2" InputId="Employee" Variant="Variant.Outlined" Margin="Margin.Dense" Style="font-size: 14px;" Disabled @bind-Value="_approver" />
                        </MudItem>
                        <MudFlexBreak />

                        <MudItem xs="8" Style="padding-top: 0px; display: flex; align-items: center;">
                            <MudInputLabel ForId="LeaveDateFrom" Style="min-width: 230px;">From-To date</MudInputLabel>
                            <MudDateRangePicker Variant="Variant.Outlined" PlaceholderStart="Start date" PlaceholderEnd="End date" Margin="Margin.Dense" Style="font-size: 14px;" />
                        </MudItem>
                        <MudItem xs="4" Style="padding-top: 0px; display: flex; align-items: center;">
                            <MudInputLabel ForId="DaysCount" Style="margin-left: 15px; margin-right: 10px;">Days count</MudInputLabel>
                            <MudTextField Typo="Typo.body2" InputId="DaysCount" Variant="Variant.Outlined" Margin="Margin.Dense" Style="font-size: 14px; width: 50px;" @bind-Value="_daysCount" Disabled />
                            <MudCheckBox @bind-Value="_isOneDayLeave">One day</MudCheckBox>
                        </MudItem>

                        <MudItem xs="6" Style="padding-top: 0px; display: flex; align-items: center;">
                            <MudInputLabel ForId="CreatedAt" Style="min-width: 230px;">Submission date</MudInputLabel>
                            <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Style="font-size: 14px;" Date="(new DateTime(2024, 6, 15))" Disabled />
                        </MudItem>
                        <MudFlexBreak />

                        <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                            <MudInputLabel ForId="ApproverComment" Style="min-width: 230px;">Comments</MudInputLabel>
                            <MudTextField InputId="ApproverComment" T="string" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" Style="font-size: 14px;" />
                        </MudItem>


                        <MudItem xs="12">
                            <MudText Typo="Typo.h6" Style="font-size: 16px; letter-spacing: .7px;">Decision</MudText>
                            <MudDivider Class="mb-3" />
                        </MudItem>

                        <MudItem xs="8" Style="padding-top: 0px; display: flex; align-items: center">
                            <MudInputLabel ForId="Approver" Style="min-width: 230px;">Approver</MudInputLabel>
                            <MudTextField Typo="Typo.body2" InputId="Approver" Variant="Variant.Outlined" Margin="Margin.Dense" Style="font-size: 14px;" Disabled @bind-Value="_approver" />
                        </MudItem>
                        <MudFlexBreak />

                        <MudItem xs="8" Style="padding-top: 0px; display: flex; align-items: center">
                            <MudInputLabel ForId="RequestStatus" Style="min-width: 230px;">Request status</MudInputLabel>
                            <MudTextField InputId="RequestStatus" Variant="Variant.Outlined" Margin="Margin.Dense" Style="font-size: 14px;" Disabled @bind-Value="_status" />
                        </MudItem>
                        <MudItem xs="4" Style="padding-top: 0px; display: flex; align-items: center">
                            <MudInputLabel ForId="ApproveDate" Style="margin-left: 15px; margin-right: 10px; min-width: 80px;">Decision date</MudInputLabel>
                            <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Style="font-size: 14px;" Disabled />
                        </MudItem>

                        <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center">
                            <MudInputLabel ForId="ApproverComment" Style="min-width: 230px;">Approver's comments</MudInputLabel>
                            <MudTextField InputId="ApproverComment" T="string" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" Style="font-size: 14px;" Disabled />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudForm>
    </MudItem>

    <MudItem xs="12" lg="4">
        <MudCard Style="min-height: 80vh;">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudIcon Style="margin-top: 5px;" Icon="@Icons.Material.Filled.History" Size="Size.Medium" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Style="font-size: 17px; letter-spacing: .7px;">Request history</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Style="margin-top: 8px;" ButtonType="ButtonType.Button" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FormatListBulleted" Href="/request-list/">Request list</MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudDivider DividerType="DividerType.Middle" />
            <MudCardContent>
                <MudText Typo="Typo.body2">No item in this section</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>


</MudGrid>

@code {
    private string _documentType = "Overtime request";
    private string _searchString;
    private string _approver = "John Doe";
    private string _status = "Pending";
    private string _availableDays = "365";
    private DateTime _startedAt;
    private bool _isOneDayLeave;
    private DateTime _createdAt = DateTime.Now;
    private int _daysCount = 2;
}