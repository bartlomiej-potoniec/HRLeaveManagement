<MudCard Style="@($"min-height: { Height }px;")">
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudIcon Style="margin-top: 5px;" Icon="@Icons.Material.Filled.Info" Size="Size.Medium" />
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6" Style="font-size: 17px; letter-spacing: .7px;">Informacje o użytkowniku</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudDivider DividerType="DividerType.Middle" />
    <MudCardContent>
        @if (Model is not null)
        {
            <MudGrid Style="padding: 5px 18px; padding-bottom: 30px; display: flex; align-items: center;">
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Style="font-size: 16px; letter-spacing: .7px;">Konto użytkownika</MudText>
                    <MudDivider Class="mb-3" />
                </MudItem>
                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudInputLabel Style="min-width: 180px;">Imię i nazwisko</MudInputLabel>
                    <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="font-size: 14px;" Value="Model.FullName" ReadOnly />
                </MudItem>
                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudInputLabel Style="min-width: 180px;">Nazwa użytkownika</MudInputLabel>
                    <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="font-size: 14px;" Value="Model.UserName" ReadOnly />
                </MudItem>
                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudInputLabel Style="min-width: 180px;">E-mail</MudInputLabel>
                    <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="font-size: 14px;" Value="Model.Email" ReadOnly />
                </MudItem>
                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudInputLabel Style="min-width: 180px;">Nr PESEL</MudInputLabel>
                    <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Value="Model.PeselNumber" ReadOnly />
                </MudItem>
                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudInputLabel Style="min-width: 180px;">Nr Telefonu</MudInputLabel>
                    <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Value="@(Model.PhoneNumber is null ? "brak" : Model.PhoneNumber )" ReadOnly />
                </MudItem>
                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudInputLabel Style="min-width: 180px;">Przypisane role</MudInputLabel>
                    <div style="display: flex; flex-wrap: nowrap; overflow-x: auto; white-space: nowrap; max-width: 170px;">
                        @foreach (var role in Model.Roles)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@role</MudChip>
                        }
                    </div>
                </MudItem>
                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudInputLabel Style="min-width: 180px;">Zatwierdzenie konta</MudInputLabel>
                    <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="@(Model.IsEmailConfirmed ? "color: #00c853" : "color: #f44336")"
                                  Value="@(Model.IsEmailConfirmed ? "Zatwierdzone" : "Niezatwierdzone")" ReadOnly />
                </MudItem>
                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudInputLabel Style="min-width: 180px;">Status konta</MudInputLabel>
                    <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="@(Model.IsLockout ? "color: #f44336" : "color: #00c853")"
                                  Value="@(Model.IsLockout ? "Zablokowane" : "Aktywne")" ReadOnly />
                </MudItem>
                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudInputLabel Style="min-width: 180px;">Blokada konta</MudInputLabel>
                    <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="@(Model.LockoutEnd is null ? "color: #00c853" : "color: #f44336")"
                                  Value="@(Model.LockoutEnd is null ? "Wyłączona" : $"do { Model.LockoutEnd.Value.Date }")" ReadOnly />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Style="font-size: 16px; letter-spacing: .7px;">Konto pracownika</MudText>
                    <MudDivider Class="mb-3" />
                </MudItem>
                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudInputLabel Style="min-width: 180px;">Identyfikator konta</MudInputLabel>
                    <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal"
                                  Value="@(Model.EmployeeId is null ? "brak" : Model.EmployeeId.ToString())" ReadOnly />
                </MudItem>
                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudInputLabel Style="min-width: 180px;">Status konta</MudInputLabel>
                    <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="@(Model.EmployeeId is null ? "color: #f44336" : "color: #00c853")"
                                  Value="@(Model.EmployeeId is null ? "Nieutworzone" : "Utworzone")" ReadOnly />
                </MudItem>
            </MudGrid>
        }
        else 
        {
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Default">Nie wybrano użytkownika</MudText>
        }
    </MudCardContent>
</MudCard>