<MudCard Style="@($"min-height: { MinHeight }; height: { Height };")">
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudIcon Style="margin-top: 5px;" Icon="@Icon" Size="Size.Medium" />
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6" Style="font-size: 17px; letter-spacing: .7px;">@Title</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            @HeaderChildContent
        </CardHeaderActions>
    </MudCardHeader>
    <MudDivider DividerType="DividerType.Middle" />
    <MudCardContent Class="@(HasOverflowScroll ? "overflow-scroll" : "")">
        <MudGrid Style="padding: 5px 18px; padding-bottom: 30px; display: flex; align-items: center; height: 100%">
            @if (HasLoader)
            {
                @if (IsLoading)
                {
                    <HrProgressCircular />
                }
                else
                {
                    @BodyChildContent
                }
            }
            else 
            {
                @BodyChildContent
            }
        </MudGrid>
    </MudCardContent>
</MudCard>