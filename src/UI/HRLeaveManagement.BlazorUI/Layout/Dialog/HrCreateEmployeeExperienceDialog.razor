@inherits HrDialog
@using HRLeaveManagement.BlazorUI.Services.Base;

<HrDialog Icon="@Icons.Material.Filled.AddCircle" OnConfirm="@Confirm">
    <ChildDescriptionContent>
        Add to the list the professional experiences of employee <b>@EmployeeFullName</b>
    </ChildDescriptionContent>
    <ChildBodyContent>
        <MudForm Model="@Model" @ref="@Form" Validation="@(Validator.ValidateValue)">
            <MudGrid Class="mt-5">
                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudSelect T="ContractType?" 
                               Label="Select conract type" 
                               @bind-Value="Model.ContractType" 
                               Variant="Variant.Outlined" 
                               Margin="Margin.Dense" 
                               For="@(() => Model.ContractType)" 
                               Immediate 
                               Clearable>
                        @foreach (var item in Model.ContractTypes)
                        {
                            <MudSelectItem Value="@item.Key">@item.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudTextField T="string" 
                                  Label="Previous company name" 
                                  @bind-Value="@Model.PreviousCompanyName" 
                                  Variant="Variant.Outlined" 
                                  Margin="Margin.Dense" 
                                  For="@(() => Model.PreviousCompanyName)" 
                                  Immediate 
                                  Clearable />
                </MudItem>

                <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudTextField T="string" 
                                  Lines="3" 
                                  Label="Position at prvious company" 
                                  @bind-Value="@Model.Position" 
                                  Variant="Variant.Outlined" 
                                  Margin="Margin.Dense" 
                                  For="@(() => Model.Position)" 
                                  Immediate 
                                  Clearable />
                </MudItem>

                <MudItem xs="8" Style="padding-top: 0px; display: flex; align-items: center;">
                    <MudDateRangePicker Label="Hire and leave date"
                                        @bind-DateRange="@Model.EmploymentDateRange" 
                                        MaxDate="@Model.MaxEmployedToDate"
                                        Variant="Variant.Outlined" 
                                        Margin="Margin.Dense"
                                        For="@(() => Model.EmployedFrom)"
                                        Clearable />
                </MudItem>
            </MudGrid>
        </MudForm>
    </ChildBodyContent>
</HrDialog>