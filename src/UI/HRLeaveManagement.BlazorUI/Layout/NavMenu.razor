<MudNavMenu Class="mt-15" Color="Color.Primary" Style="font-size: 15px;">
    <AuthorizeView Roles="Administrator">
        <Authorized>
            <MudNavGroup Title="Administracja" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded>
                <MudNavLink Href="auth/register-user">Utwórz nowego użytkownika</MudNavLink>
                <MudNavLink Href="users/list">Lista użytkowników</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="HR">
        <Authorized>
            <MudNavGroup Title="HR" Icon="@Icons.Material.Filled.Groups2" IconColor="Color.Inherit" Expanded>
                <MudNavGroup Title="Działy i sekcje" Icon="@Icons.Material.Filled.FreeCancellation">
                    <MudNavLink Href="departments/create">Utwórz dział/sekcje</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Pracownicy" Icon="@Icons.Material.Filled.EmojiPeople">
                    <MudNavLink Href="employees/create">Utwórz nowego pracownika</MudNavLink>
                    <MudNavLink Href="users/pending">Lista użytkowników oczekujących</MudNavLink>
                    <MudNavLink Href="employees/list">Lista pracowników</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Urlopy pracownicze" Icon="@Icons.Material.Filled.FreeCancellation">
                    <MudNavLink Href="leaves/allocation">Przydział urlopów</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Praca zdalna" Icon="@Icons.Material.Rounded.HomeWork">
                    <MudNavLink Href="remote-works/list">Limity pracy zdalnej</MudNavLink>
                </MudNavGroup>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Employee">
        <Authorized>
            @* <MudText Typo="Typo.h6">@context.User?.Identity?.Name</MudText> *@
            @* <MudDivider Class="my-2"/> *@
            <MudNavLink Href="dashboard" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Inherit" >Dashboard</MudNavLink>

            <MudNavGroup Title="Czas Pracy" Icon="@Icons.Material.Filled.AccessTime" IconColor="Color.Inherit" Expanded>
                <MudNavLink Href="worktime/register">Rejestracja czasu pracy</MudNavLink>
                <MudNavLink Href="remotework-request/create">Wniosek o pracę zdalną</MudNavLink>
                <MudNavLink Href="overtime-request/create">Wniosek o nadgodziny</MudNavLink>
                <MudNavLink Href="worktime/list">Lista wniosków</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Urlopy i nieobecności" Icon="@Icons.Material.Filled.DateRange" IconColor="Color.Inherit" Expanded>
                <MudNavLink Href="leave-requests/add/">Wniosek o urlop</MudNavLink>
                <MudNavLink Href="leave-requests/list/">Lista wniosków urlopowych</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Delegacje" Icon="@Icons.Material.Filled.Public" IconColor="Color.Inherit" Expanded>
                <MudNavLink Href="trip-request/create">Wniosek o delegacje</MudNavLink>
                <MudNavLink Href="trip-request/list">Lista wniosków o delegacje</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Pracownik" Icon="@Icons.Material.Filled.Person" IconColor="Color.Inherit" Expanded>
                <MudNavLink Href="leave-requests/employee-index">Leave Requests</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

</MudNavMenu>