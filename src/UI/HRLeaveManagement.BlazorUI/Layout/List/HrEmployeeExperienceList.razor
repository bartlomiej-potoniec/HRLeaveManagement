<MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
    <MudInputLabel ForId="Leader" Style="min-width: 230px;">Experience history</MudInputLabel>
    <MudPaper Width="100%">
        <MudList T="string" Dense Padding Disabled="@IsDisabled">
            <MudListSubheader Class="d-flex align-center justify-space-between">
                <MudText Inline Typo="Typo.subtitle2">List of employee's professional experience</MudText>
                @if (HasOptionsButtons)
                {
                    <MudButton ButtonType="ButtonType.Button" 
                               Variant="Variant.Filled" 
                               Size="Size.Small" 
                               OnClick="AddExperienceToListDialogAsync" 
                               StartIcon="@Icons.Material.Filled.AddCircle" 
                               Color="Color.Primary" 
                               Disabled="@IsDisabled">
                        Add
                    </MudButton>
                }
            </MudListSubheader>
            @if (Experiences.Any())
            {
                @foreach (var experience in Experiences)
                {
                    <MudListItem Text="@($"{ @experience.PreviousCompanyName } ({ experience.Position })")" 
                                 Icon="@Icons.Material.Filled.WorkspacePremium" 
                                 IconColor="Color.Dark">
                        <NestedList>
                            <MudGrid Style="padding-left: 45px;">
                                <MudItem xs="10">
                                    <MudItem Class="d-inline-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.HomeWork" Size="Size.Small" Style="margin-right: 7px;" />
                                        <MudText Inline>@experience.PreviousCompanyName</MudText>
                                    </MudItem>
                                    <MudFlexBreak />
                                    <MudItem Class="d-inline-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Details" Size="Size.Small" Style="margin-right: 7px;" />
                                        <MudText Inline>Contract type: @experience.ContractTypes[experience.ContractType]</MudText>
                                    </MudItem>
                                    <MudFlexBreak />
                                    <MudItem Class="d-inline-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.DateRange" Size="Size.Small" Style="margin-right: 7px;" />
                                        <MudText Inline>From-To date: @experience.EmployedFromShortDate - @experience.EmployedToShortDate</MudText>
                                    </MudItem>
                                </MudItem>
                                @if (HasOptionsForItems)
                                {
                                    <MudItem xs="2">
                                        <MudMenu Icon="@Icons.Material.Filled.MoreHoriz">
                                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" 
                                                         OnClick="() => UpdateExperienceInListDialogAsync(experience)" 
                                                         IconColor="Color.Warning">
                                            </MudMenuItem>
                                            <MudDivider />
                                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" 
                                                         OnClick="() => RemoveExperienceFromListDialogAsync(experience)" 
                                                         IconColor="Color.Error">
                                            </MudMenuItem>
                                        </MudMenu>
                                    </MudItem>
                                }
                            </MudGrid>
                        </NestedList>
                    </MudListItem>
                }
            }
            else
            {
                <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Default">
                    No information about experience has been added.
                    <MudLink OnClick="AddExperienceToListDialogAsync" Disabled="@IsDisabled">Add information</MudLink>
                </MudText>
            }
        </MudList>
    </MudPaper>
</MudItem>