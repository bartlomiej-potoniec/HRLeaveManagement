<MudItem xs="@Xs" Style="padding-top: 0px; display: flex; align-items: center;">
    <MudInputLabel ForId="@InputId" Style="min-width: 230px;">@Label</MudInputLabel>
    <MudDatePicker Variant="@Variant"
                   Margin="@Margin"
                   Date="@Date"
                   DateChanged="@DateChanged"
                   For="@For"
                   ImmediateText
                   ReadOnly="@IsReadOnly"
                   Disabled="@IsDisabled"
                   Clearable="@IsClearable"
                   Style="font-size: 14px;" />
</MudItem>