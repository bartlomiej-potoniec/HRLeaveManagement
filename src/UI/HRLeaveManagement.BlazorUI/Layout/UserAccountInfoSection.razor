<MudCard Style="@($"min-height: { Height }px;")">
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudIcon Style="margin-top: 5px;" Icon="@Icons.Material.Filled.Info" Size="Size.Medium" />
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6" Style="font-size: 17px; letter-spacing: .7px;">Informacje o koncie</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButtonGroup Style="margin-top: 8px;" Color="Color.Default" Variant="Variant.Filled">
                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ManageAccounts">Akcje</MudButton>
                <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;">
                    @if (Model.IsLockout)
                    {
                        <MudMenuItem OnClick="@(() => UnlockAccount())" Icon="@Icons.Material.Filled.CheckCircle">Odblokuj konto</MudMenuItem>
                    }
                    else
                    {
                        <MudMenuItem OnClick="@(() => LockoutAccount())" Icon="@Icons.Material.Filled.Block">Zablokuj konto</MudMenuItem>
                    }
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete">Usuń konto</MudMenuItem>
                </MudMenu>
            </MudButtonGroup>
        </CardHeaderActions>
    </MudCardHeader>
    <MudDivider DividerType="DividerType.Middle" />
    <MudCardContent>
        <MudGrid Style="padding: 5px 18px; padding-bottom: 30px; display: flex; align-items: center;">
            <MudItem xs="12">
                <MudText Typo="Typo.h6" Style="font-size: 16px; letter-spacing: .7px;">Konto użytkownika</MudText>
                <MudDivider Class="mb-3" />
            </MudItem>
            <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                <MudInputLabel Style="min-width: 180px;">Identyfikator konta</MudInputLabel>
                <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="font-size: 14px;" Value="Model.Id" ReadOnly />
            </MudItem>
            <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                <MudInputLabel Style="min-width: 180px;">Nazwa użytkownika</MudInputLabel>
                <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="font-size: 14px;" Value="Model.UserName" ReadOnly />
            </MudItem>
            <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                <MudInputLabel Style="min-width: 180px;">Zatwierdzenie konta</MudInputLabel>
                <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="font-size: 14px;"
                              Value="@(Model.IsEmailConfirmed ? "Zatwierdzone" : "Niezatwierdzone")" ReadOnly />
            </MudItem>
            <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                <MudInputLabel Style="min-width: 180px;">Status konta</MudInputLabel>
                <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="font-size: 14px;"
                              Value="@(Model.IsLockout ? "Zablokowane" : "Aktywne")" ReadOnly />
            </MudItem>
            <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                <MudInputLabel Style="min-width: 180px;">Blokada konta</MudInputLabel>
                <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="font-size: 14px;"
                              Value="@(Model.LockoutEnd is null ? "Wyłączona" : $"do { Model.LockoutEnd.Value.Date }")" ReadOnly />
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.h6" Style="font-size: 16px; letter-spacing: .7px;">Konto pracownika</MudText>
                <MudDivider Class="mb-3" />
            </MudItem>
            <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                <MudInputLabel Style="min-width: 180px;">Identyfikator konta</MudInputLabel>
                <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="font-size: 14px;"
                              Value="@(Model.EmployeeId is null ? "brak" : Model.EmployeeId.ToString())" ReadOnly />
            </MudItem>
            <MudItem xs="12" Style="padding-top: 0px; display: flex; align-items: center;">
                <MudInputLabel Style="min-width: 180px;">Status konta</MudInputLabel>
                <MudTextField Typo="Typo.body2" Variant="Variant.Text" Margin="Margin.Normal" Style="font-size: 14px;"
                              Value="@(Model.EmployeeId is null ? "Nieutworzone" : "Utworzone")" ReadOnly />
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>